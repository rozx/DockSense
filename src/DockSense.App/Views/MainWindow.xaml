<ui:FluentWindow
    x:Class="DockSense.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:DockSense.App.Localization"
    xmlns:pages="clr-namespace:DockSense.App.Views.Pages"
    Title="DockSense"
    Width="1080"
    Height="760"
    MinWidth="860"
    MinHeight="580"
    ExtendsContentIntoTitleBar="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Icon="pack://application:,,,/Assets/app.ico"
    RenderOptions.BitmapScalingMode="NearestNeighbor">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DockSense">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-small.png" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="232"
            PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{loc:T Nav_Status}" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem Content="{loc:T Nav_Profiles}" Icon="{ui:SymbolIcon Options24}" TargetPageType="{x:Type pages:ProfilesPage}" />
                <ui:NavigationViewItem Content="{loc:T Nav_Detection}" Icon="{ui:SymbolIcon ScanDash24}" TargetPageType="{x:Type pages:DetectionPage}" />
                <ui:NavigationViewItem Content="{loc:T Nav_Settings}" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{loc:T Nav_About}" Icon="{ui:SymbolIcon Info24}" TargetPageType="{x:Type pages:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
