<Page
    x:Class="DockSense.App.Views.Pages.DetectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:DockSense.App.Localization"
    Title="Detection">
    <StackPanel Margin="32,16,32,32">
        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T Det_Title}" />
        <TextBlock Style="{StaticResource Secondary}" Text="{loc:T Det_Subtitle}" Margin="0,4,0,16" />

        <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon Timer24}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,24,0">
                    <ui:TextBlock FontTypography="BodyStrong" Text="{loc:T Det_Settle}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{loc:T Det_SettleDesc}" FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <Slider Width="220" VerticalAlignment="Center" IsSnapToTickEnabled="True" Maximum="30" Minimum="0" TickFrequency="1" Value="{Binding SettleSeconds}" />
                <TextBlock Width="56" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding SettleText}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon PlugConnected24}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,24,0">
                    <ui:TextBlock FontTypography="BodyStrong" Text="{loc:T Det_RequireAc}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{loc:T Det_RequireAcDesc}" FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding DockedRequiresAc}" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T Det_Adapters}" />
        <TextBlock Style="{StaticResource Secondary}" Text="{loc:T Det_AdaptersDesc}" Margin="2,0,0,10" />
        <ItemsControl ItemsSource="{Binding AdapterOverrides}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon DeveloperBoard24}">
                        <ui:CardControl.Header>
                            <StackPanel Margin="0,0,24,0">
                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding DetectedText}" FontSize="12" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding InstanceId}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox
                            Width="240"
                            DisplayMemberPath="Label"
                            ItemsSource="{Binding Options}"
                            SelectedValue="{Binding Selected}"
                            SelectedValuePath="Value" />
                    </ui:CardControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
