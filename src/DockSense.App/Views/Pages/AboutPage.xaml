<Page
    x:Class="DockSense.App.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:DockSense.App.Localization"
    Title="About">
    <StackPanel Margin="32,16,32,32">
        <ui:Card Padding="32">
            <StackPanel HorizontalAlignment="Center">
                <Image
                    Width="120"
                    Height="120"
                    HorizontalAlignment="Center"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    Source="pack://application:,,,/Assets/app.png" />
                <TextBlock HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="30" FontWeight="SemiBold" Text="DockSense" />
                <TextBlock Style="{StaticResource Secondary}" HorizontalAlignment="Center" FontSize="15" Text="{loc:T About_Tagline}" Margin="0,4,0,4" />
                <TextBlock Style="{StaticResource Secondary}" HorizontalAlignment="Center" Text="{Binding VersionText}" />
                <StackPanel Margin="0,6,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center" Text="{loc:T About_Author}" />
                    <ui:HyperlinkButton
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Content="rozx"
                        NavigateUri="https://github.com/rozx" />
                </StackPanel>

                <WrapPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                    <ui:Button Margin="4" Appearance="Primary" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/rozx/DockSense" Content="{loc:T About_GitHub}" Icon="{ui:SymbolIcon Code24}" />
                    <ui:Button Margin="4" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/rozx/DockSense/issues/new" Content="{loc:T About_Issue}" Icon="{ui:SymbolIcon Bug24}" />
                    <ui:Button Margin="4" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/rozx/DockSense/blob/main/docs/game-mode-throttle.md" Content="{loc:T About_Analysis}" Icon="{ui:SymbolIcon Document24}" />
                </WrapPanel>
            </StackPanel>
        </ui:Card>

        <ui:CardControl Margin="0,12,0,0" Icon="{ui:SymbolIcon Toolbox24}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,24,0">
                    <ui:TextBlock FontTypography="BodyStrong" Text="{loc:T About_Diagnostics}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{loc:T About_DiagnosticsDesc}" FontSize="12" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Command="{Binding CopyReportCommand}" Content="{Binding CopyReportText}" Icon="{ui:SymbolIcon Copy24}" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,20,0,0" Text="{loc:T About_License}" />
    </StackPanel>
</Page>
