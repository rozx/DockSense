<Page
    x:Class="DockSense.App.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:DockSense.App.Localization"
    Title="Status">
    <Page.Resources>
        <!-- Hardware row: name on the left, hairline label on the right. -->
        <DataTemplate x:Key="HardwareRow">
            <DockPanel Margin="0,5">
                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                    <TextBlock x:Name="BadgeText" Text="{Binding Badge}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExternal}" Value="True">
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Page.Resources>

    <StackPanel Margin="36,20,36,36">
        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T Nav_Status}" Margin="0,0,0,20" />

        <!-- Current mode -->
        <ui:Card Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="96" Height="96" CornerRadius="12" Background="{DynamicResource IconTileBrush}">
                    <Image Source="{Binding ModeIcon}" Width="64" Height="64" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>

                <StackPanel Grid.Column="1" Margin="24,0,16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding ModeAccent}" Margin="0,2,10,0" />
                        <TextBlock Style="{StaticResource ModeTitle}" Text="{Binding ModeTitle}" />
                        <Border Style="{StaticResource Pill}" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:T Status_Paused}" FontSize="12" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding ModeDetail}" Margin="18,2,0,16" />

                    <WrapPanel Margin="18,0,0,0">
                        <StackPanel Margin="0,0,40,6">
                            <TextBlock Style="{StaticResource Secondary}" Text="{loc:T Dash_PowerPlan}" FontSize="12" />
                            <TextBlock Text="{Binding PlanName}" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,40,6">
                            <TextBlock Style="{StaticResource Secondary}" Text="{loc:T Dash_FseNow}" FontSize="12" />
                            <TextBlock Text="{Binding FseNowText}" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,40,6">
                            <TextBlock Style="{StaticResource Secondary}" Text="{loc:T Dash_Fse}" FontSize="12" />
                            <TextBlock Text="{Binding FseText}" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,40,6" Visibility="{Binding IgpuAvailable, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Secondary}" Text="{loc:T Dash_Igpu}" FontSize="12" />
                            <TextBlock Text="{Binding IgpuText}" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,40,6">
                            <TextBlock Style="{StaticResource Secondary}" Text="{loc:T Dash_Power}" FontSize="12" />
                            <TextBlock Text="{Binding PowerText}" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <ui:Button
                        Width="136"
                        Margin="0,0,0,8"
                        HorizontalContentAlignment="Left"
                        Appearance="Primary"
                        AutomationProperties.Name="{loc:T Dash_Recheck}"
                        Command="{Binding RecheckCommand}"
                        Content="{loc:T Dash_Recheck}"
                        Icon="{ui:SymbolIcon ArrowSync24}" />
                    <ui:Button
                        Width="136"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.Name="{Binding PauseButtonText}"
                        Command="{Binding TogglePauseCommand}"
                        Content="{Binding PauseButtonText}"
                        Icon="{ui:SymbolIcon Pause24}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- iGPU memory waiting for a restart -->
        <ui:Card Margin="0,12,0,0" Padding="16,12" Visibility="{Binding IgpuPending, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <ui:Button
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{loc:T Dash_RestartNow}"
                    Command="{Binding RestartCommand}"
                    Content="{loc:T Dash_RestartNow}"
                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
                <Ellipse Style="{StaticResource Dot}" Fill="#FBBF24" Margin="2,0,12,0" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="BodyStrong" Text="{loc:T Dash_IgpuPendingTitle}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding IgpuPendingMessage}" />
                </StackPanel>
            </DockPanel>
        </ui:Card>

        <!-- A newer release -->
        <ui:Card Margin="0,12,0,0" Padding="16,12" Visibility="{Binding UpdateVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                        AutomationProperties.Name="{loc:T Upd_WhatsNew}"
                        Command="{Binding OpenReleasePageCommand}"
                        Content="{loc:T Upd_WhatsNew}"
                        Icon="{ui:SymbolIcon Open24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Primary"
                        AutomationProperties.Name="{Binding UpdateActionText}"
                        Command="{Binding InstallUpdateCommand}"
                        Content="{Binding UpdateActionText}"
                        Icon="{ui:SymbolIcon ArrowDownload24}"
                        Visibility="{Binding UpdateActionVisible, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <Ellipse Style="{StaticResource Dot}" Fill="#60A5FA" Margin="2,0,12,0" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding UpdateTitle}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding UpdateMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </ui:Card>

        <!-- Game Mode throttle check -->
        <ui:InfoBar
            Margin="0,12,0,0"
            IsClosable="False"
            IsOpen="True"
            Message="{Binding ThrottleMessage}"
            Severity="{Binding ThrottleSeverity}"
            Title="{Binding ThrottleTitle}" />
        <ui:HyperlinkButton
            Margin="0,4,0,0"
            Padding="4,2"
            Content="{loc:T Dash_LearnMore}"
            Icon="{ui:SymbolIcon Open24}"
            NavigateUri="https://github.com/rozx/DockSense/blob/main/docs/game-mode-throttle.md" />

        <!-- Hardware -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Card Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T Dash_Adapters}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Adapters}" ItemTemplate="{StaticResource HardwareRow}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Grid.Column="2" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T Dash_Displays}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Displays}" ItemTemplate="{StaticResource HardwareRow}" />
                </StackPanel>
            </ui:Card>
        </Grid>

        <!-- Activity -->
        <ui:Card Margin="0,12,0,0" Padding="20">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T Dash_Activity}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Activity}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Time, StringFormat=HH:mm:ss}" FontFamily="Cascadia Mono, Consolas" />
                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
