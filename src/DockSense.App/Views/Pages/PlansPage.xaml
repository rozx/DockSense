<Page
    x:Class="DockSense.App.Views.Pages.PlansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:DockSense.App.Localization"
    Title="Power plans">
    <StackPanel Margin="32,16,32,32" DataContext="{Binding Plans}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T Plans_Title}" />
        <TextBlock Style="{StaticResource Secondary}" Text="{loc:T Plans_Subtitle}" Margin="0,4,0,16" />

        <!-- New plan -->
        <ui:Card Padding="20" Margin="0,0,0,6">
            <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong" Text="{loc:T Plans_New}" />
                <TextBlock Style="{StaticResource Secondary}" Text="{loc:T Plans_NewDesc}" FontSize="12" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        AutomationProperties.Name="{loc:T Plans_Name}"
                        PlaceholderText="{loc:T Plans_NamePlaceholder}"
                        Text="{Binding NewPlanName, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        Grid.Column="2"
                        AutomationProperties.Name="{loc:T Plans_BasedOn}"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding BaseOptions}"
                        SelectedValue="{Binding NewPlanBase}"
                        SelectedValuePath="Value"
                        ToolTip="{loc:T Plans_BasedOn}" />
                    <ui:Button
                        Grid.Column="4"
                        Appearance="Primary"
                        AutomationProperties.Name="{loc:T Plans_Create}"
                        Command="{Binding CreateCommand}"
                        Content="{loc:T Plans_Create}"
                        Icon="{ui:SymbolIcon Add24}" />
                </Grid>
                <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,8,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ui:Card>

        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:T Plans_All}" />

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardExpander Margin="0,0,0,6" Icon="{ui:SymbolIcon Flash24}" IsExpanded="{Binding IsExpanded}">
                        <ui:CardExpander.Header>
                            <WrapPanel VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <Border Style="{StaticResource Pill}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource Dot}" Width="6" Height="6" Fill="#4ADE80" Margin="0,1,6,0" />
                                        <TextBlock Text="{loc:T Plans_Active}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Pill}" Visibility="{Binding HasType, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding TypeText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Visibility="{Binding HasUsedBy, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding UsedByText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Visibility="{Binding IsThrottled, Converter={StaticResource BoolToVisibility}}" ToolTip="{loc:T Plans_ThrottledTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource Dot}" Width="6" Height="6" Fill="#FBBF24" Margin="0,1,6,0" />
                                        <TextBlock Text="{loc:T Plans_Throttled}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </ui:CardExpander.Header>

                        <StackPanel Margin="4,4,4,0">
                            <!-- Name -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{loc:T Plans_Name}" />
                                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{loc:T Plans_BuiltInNote}" Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <ui:TextBox
                                    Grid.Column="1"
                                    Width="404"
                                    AutomationProperties.Name="{loc:T Plans_Name}"
                                    IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBool}}"
                                    Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <!-- Column headers -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="196" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="196" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" FontSize="12" Text="{loc:T Plans_Ac}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource Secondary}" FontSize="12" Text="{loc:T Plans_Dc}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Settings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="196" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="196" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" />
                                                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Description}" />
                                            </StackPanel>

                                            <!-- Numbers -->
                                            <DockPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock DockPanel.Dock="Right" Width="34" Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding Unit}" />
                                                <ui:NumberBox
                                                    AutomationProperties.Name="{Binding Label}"
                                                    ClearButtonEnabled="False"
                                                    MaxDecimalPlaces="0"
                                                    Maximum="{Binding Maximum}"
                                                    Minimum="0"
                                                    SpinButtonPlacementMode="Hidden"
                                                    Value="{Binding AcNumber, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Grid.Column="3" VerticalAlignment="Center" Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock DockPanel.Dock="Right" Width="34" Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding Unit}" />
                                                <ui:NumberBox
                                                    AutomationProperties.Name="{Binding Label}"
                                                    ClearButtonEnabled="False"
                                                    MaxDecimalPlaces="0"
                                                    Maximum="{Binding Maximum}"
                                                    Minimum="0"
                                                    SpinButtonPlacementMode="Hidden"
                                                    Value="{Binding DcNumber, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>

                                            <!-- Choices -->
                                            <ComboBox
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding Label}"
                                                DisplayMemberPath="Label"
                                                ItemsSource="{Binding Choices}"
                                                SelectedValue="{Binding AcChoice}"
                                                SelectedValuePath="Value"
                                                Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                                            <ComboBox
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding Label}"
                                                DisplayMemberPath="Label"
                                                ItemsSource="{Binding Choices}"
                                                SelectedValue="{Binding DcChoice}"
                                                SelectedValuePath="Value"
                                                Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="0,4,0,12" />

                            <DockPanel>
                                <ui:Button
                                    DockPanel.Dock="Right"
                                    AutomationProperties.Name="{loc:T Plans_Delete}"
                                    Command="{Binding DeleteCommand}"
                                    Content="{loc:T Plans_Delete}"
                                    Icon="{ui:SymbolIcon Delete24}" />
                                <ui:Button
                                    Appearance="Primary"
                                    AutomationProperties.Name="{loc:T Plans_Save}"
                                    Command="{Binding SaveCommand}"
                                    Content="{loc:T Plans_Save}"
                                    Icon="{ui:SymbolIcon Save24}"
                                    Margin="0,0,8,0" />
                                <ui:Button
                                    AutomationProperties.Name="{loc:T Plans_Revert}"
                                    Command="{Binding RevertCommand}"
                                    Content="{loc:T Plans_Revert}"
                                    Icon="{ui:SymbolIcon ArrowUndo24}"
                                    Margin="0,0,12,0" />
                                <TextBlock
                                    Style="{StaticResource Secondary}"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="{Binding StatusText}"
                                    ToolTip="{Binding StatusText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </DockPanel>
                        </StackPanel>
                    </ui:CardExpander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
